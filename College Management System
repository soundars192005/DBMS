DROP TABLE IF EXISTS grade;
DROP TABLE IF EXISTS fee;
DROP TABLE IF EXISTS enrollment;
DROP TABLE IF EXISTS professor_course;
DROP TABLE IF EXISTS course_prerequisite;
DROP TABLE IF EXISTS course;
DROP TABLE IF EXISTS student;
DROP TABLE IF EXISTS professor;
DROP TABLE IF EXISTS department;
CREATE TABLE department (
dept_id INTEGER PRIMARY KEY AUTOINCREMENT,
dept_code TEXT UNIQUE,
dept_name TEXT NOT NULL
);
CREATE TABLE professor (
prof_id INTEGER PRIMARY KEY AUTOINCREMENT,
first_name TEXT,
last_name TEXT,
hire_date TEXT,
salary REAL,
dept_id INTEGER,
FOREIGN KEY (dept_id) REFERENCES department(dept_id)
);
CREATE TABLE course (
course_id INTEGER PRIMARY KEY AUTOINCREMENT,
course_code TEXT UNIQUE,
course_name TEXT,
credits INTEGER,
capacity INTEGER,
dept_id INTEGER,
FOREIGN KEY (dept_id) REFERENCES department(dept_id)
);
CREATE TABLE course_prerequisite (
course_id INTEGER,
prereq_course_id INTEGER,
PRIMARY KEY (course_id, prereq_course_id),
FOREIGN KEY (course_id) REFERENCES course(course_id),
FOREIGN KEY (prereq_course_id) REFERENCES course(course_id)
);
CREATE TABLE professor_course (
prof_id INTEGER,
course_id INTEGER,
PRIMARY KEY (prof_id, course_id),
FOREIGN KEY (prof_id) REFERENCES professor(prof_id),
FOREIGN KEY (course_id) REFERENCES course(course_id)
);
CREATE TABLE student (
student_id INTEGER PRIMARY KEY AUTOINCREMENT,
first_name TEXT,
last_name TEXT,
email TEXT UNIQUE,
dob TEXT,
address TEXT,
admission_year INTEGER,
dept_id INTEGER,
FOREIGN KEY (dept_id) REFERENCES department(dept_id)
);
CREATE TABLE enrollment (
enroll_id INTEGER PRIMARY KEY AUTOINCREMENT,
student_id INTEGER,
course_id INTEGER,
semester TEXT,
enroll_date TEXT,
UNIQUE (student_id, course_id, semester),
FOREIGN KEY (student_id) REFERENCES student(student_id),
FOREIGN KEY (course_id) REFERENCES course(course_id)
);
CREATE TABLE grade (
grade_id INTEGER PRIMARY KEY AUTOINCREMENT,
enroll_id INTEGER UNIQUE,
prof_id INTEGER,
grade TEXT,
grade_date TEXT,
FOREIGN KEY (enroll_id) REFERENCES enrollment(enroll_id),
FOREIGN KEY (prof_id) REFERENCES professor(prof_id)
);
CREATE TABLE fee (
fee_id INTEGER PRIMARY KEY AUTOINCREMENT,
student_id INTEGER,
semester TEXT,
amount REAL,
UNIQUE (student_id, semester),
FOREIGN KEY (student_id) REFERENCES student(student_id)
);
